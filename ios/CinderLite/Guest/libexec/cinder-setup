#!/bin/sh
# First-run setup, in the Claude tab under the app's setup checklist, in its order (and Android's):
# Claude Code, which Cinder Lite downloads and checks (sha512) on the iOS side once the user taps
# Download there and hands over in /usr/local/dl, then Alpine's base tools. Safe to re-run: the
# checklist ticks off what's done.
set -e
dl=/usr/local/dl
mkdir -p /workspace
# What Reinstall sandbox kept of /root (the login, settings, history) goes back in place.
if [ -d $dl/keep ]; then
  cp -a $dl/keep/. /root/
  rm -rf $dl/keep
fi
# Alpine's stable main and community, plus edge and testing on request (apk add foo@edge).
release=$(cut -d. -f1,2 /etc/alpine-release)
m=https://dl-cdn.alpinelinux.org/alpine
printf '%s\n' "$m/v$release/main" "$m/v$release/community" "@edge $m/edge/main" "@edge $m/edge/community" \
  "@testing $m/edge/testing" > /etc/apk/repositories

if [ ! -L /root/.local/bin/claude ]; then
  last=""
  [ -f $dl/claude-installer ] || echo "Waiting for Claude Code's download (the checklist asks for it)…"
  until [ -f $dl/claude-installer ]; do
    if [ -f $dl/error ]; then echo; cat $dl/error; exit 1; fi
    now=$(cat $dl/progress 2>/dev/null || true)
    [ -n "$now" ] && [ "$now" != "$last" ] && { printf '\r%s   ' "$now"; last=$now; }
    sleep 1
  done
  echo
  echo "Installing Claude Code…"
  chmod +x $dl/claude-installer
  $dl/claude-installer install latest
  rm -f $dl/claude-installer $dl/progress
fi

base="bash coreutils findutils grep sed git ripgrep less curl python3 py3-pip nodejs npm openssh-client make patch zip jq tzdata"
if ! apk info -e bash python3 nodejs tzdata >/dev/null 2>&1; then
  echo "Installing the base tools (this runs in an emulator: a few minutes)…"
  apk add --no-cache $base
fi
