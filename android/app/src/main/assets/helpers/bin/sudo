#!/bin/sh
# Fake root by re-entering the rootfs through a nested proot -0. This is the only elevation that
# works on Android: fakeroot needs a SysV-IPC daemon (absent from the kernel), and the files are
# already ours anyway; apk only refuses to run unless it believes it is uid 0, which -0 provides.
exec /usr/local/shims/proot -0 -r / \
  -b /system:/system -b /apex:/apex -b /proc:/proc -b /dev:/dev -b /sys:/sys \
  -w "$PWD" "$@"
