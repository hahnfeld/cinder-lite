#!/bin/sh
# xdg-open <https link | file>: the sandbox can't open a browser or other apps, so leave the request
# where the app is watching for it (SessionService's FileObserver). A link opens in the browser; a
# file in the app the user picks. Written then renamed, so the app never reads a half-written file.

fail() { echo "xdg-open: $*" >&2; exit 1; }
case "$1" in
  https://*) request=$1 ;;
  *)
    path=${1#file://}
    [ "$path" = "$1" ] || path=$(printf '%b' "$(printf '%s' "$path" | sed 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')")
    if [ ! -e "$path" ]; then
      case "$1" in [a-zA-Z]*:*) fail "only https links and files open here" ;; esac
      fail "no such file: $1"
    fi
    file=$(realpath -- "$path") && [ -f "$file" ] || fail "not a file: $1"
    case "$file" in
      */.*) fail "hidden files (logins, keys, settings) don't open here" ;;
      *.[aA][pP][kK]) fail "APKs don't open from here: copy it to /sdcard/Download and ask the user to open it there" ;;
    esac
    request=$file ;;
esac
mkdir -p /root/.cinder
printf '%s\n' "$request" > /root/.cinder/open-request.tmp && mv /root/.cinder/open-request.tmp /root/.cinder/open-request
