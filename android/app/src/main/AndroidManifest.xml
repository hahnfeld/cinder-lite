<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Shared storage, bound into the sandbox at /sdcard. With targetSdk 28 this is the legacy
         full-access permission, the same one Termux's termux-setup-storage relies on. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:label="Cinder Lite"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cinder">

        <!-- configChanges: rotating, folding or changing font scale / locale just resizes the
             terminal (SIGWINCH) instead of recreating the activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Holds the process alive while Claude Code runs: the CLI is a child of this process,
             so being backgrounded is what would kill it. -->
        <service
            android:name=".SessionService"
            android:exported="false" />

        <!-- Modules' components (app/cinder/module/) are on only while their module is (Modules.set),
             so one that's off can't run or show up in Settings. Most start android:enabled="false"
             here; the exceptions say why. -->

        <!-- Phone Use: the phone screen Claude drives (`phone` in the sandbox), a picture-in-picture
             window showing a virtual display. Its own task, so the PiP never takes the terminal with
             it; configChanges, since recreating it would close the display and the apps on it. -->
        <activity
            android:name=".module.phone.PhoneScreenActivity"
            android:enabled="false"
            android:exported="false"
            android:label="Phone screen"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.phone"
            android:excludeFromRecents="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection" />

        <!-- Phone Use: how Claude reads and operates the phone screen. The user turns it on in
             Android's Accessibility settings; it only reads the phone screen, and only when asked.
             Its class stays app.cinder.PhoneAccessibility: that's the name the setting remembers.
             Enabled here, and switched off at first launch if Phone Use is: Android drops a disabled
             service from that setting when the app updates, so an update that shipped it disabled
             would turn it off for everyone who had turned it on. -->
        <service
            android:name=".PhoneAccessibility"
            android:exported="true"
            android:label="Cinder Lite phone screen"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/phone_accessibility" />
        </service>

        <!-- Network Monitor (⋮ → Watch network traffic): the user turns it on, Android asks for VPN
             consent the first time and shows a key icon while it runs. -->
        <service
            android:name=".module.traffic.TrafficVpn"
            android:enabled="false"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Hands a sandbox file to the app the user picks (xdg-open on a file): read-only, and only
             the file each grant names. -->
        <provider
            android:name=".SharedFiles"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Phone Use: receives Shizuku's binder, for the optional adb-shell access (⋮ → Shizuku).
             Always enabled, unlike the module's other components: Shizuku hands its binder over when
             this process starts, so one enabled later would miss it until the app restarted. Only
             the system can call it (INTERACT_ACROSS_USERS_FULL), and nothing uses the binder unless
             Phone Use and ⋮ → Shizuku are both on. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
