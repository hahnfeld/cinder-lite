#!/bin/sh
# The Claude tab: set up on first run, then Claude Code with Cinder Lite's brief and hooks.
# A failed setup leaves its error on screen and in setup-error, where the app's checklist shows it
# (✗ and Retry), and tries again on Enter, which Retry sends.
dl=/usr/local/dl
rm -f $dl/setup-error
until sh /usr/local/libexec/cinder-setup; do
  echo
  echo "Setup didn't finish. Check the connection and free space, then Retry (or press Enter);"
  echo "⋮ → Reinstall sandbox starts over."
  { cat $dl/error 2>/dev/null || echo "Setup didn't finish. Check the connection and free space; Details shows what happened."; } > $dl/setup-error
  read -r _
  rm -f $dl/setup-error
done
cd /workspace
# This session started before setup installed bash; Claude Code's Bash tool should get it anyway.
[ -x /bin/bash ] && export SHELL=/bin/bash
# Claude Code's own update check is off (it slowed every start in the emulator), so it updates here:
# once a day, a minute after starting, in its own session so it outlives this one.
stamp=/root/.cache/cinder-update
if [ -z "$(find $stamp -mtime -1 2>/dev/null)" ]; then
  mkdir -p /root/.cache && : > $stamp
  setsid sh -c 'sleep 60; exec /root/.local/bin/claude update' </dev/null >$stamp.log 2>&1 &
fi
exec /root/.local/bin/claude --settings /usr/local/libexec/cinder-settings.json \
  --append-system-prompt "$(cat /usr/local/libexec/cinder-brief.md)"
