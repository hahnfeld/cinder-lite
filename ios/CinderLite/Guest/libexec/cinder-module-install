#!/bin/sh
# Installs a module the first time it's turned on (⋮ → Modules), in the Shell tab where its progress
# shows: cinder-module-install <package>... installs the packages, then runs the module's own setup
# ($CINDER_MODULE_SETUP). The app turns the module on, and remembers it's installed, only if this
# succeeds. cinder-module-install --remove <package>... is the reverse, when it's turned off.
set -e
if [ "$1" = --remove ]; then
  shift
  if [ $# -gt 0 ]; then apk del "$@"; fi
  echo "Removed."
  exit 0
fi
if [ $# -gt 0 ]; then apk add "$@"; fi
if [ -n "$CINDER_MODULE_SETUP" ]; then sh -c "$CINDER_MODULE_SETUP"; fi
echo "Installed."
