#!/bin/sh
# APK reverse-engineering kit: apktool and jadx, pure Java on Alpine's own musl JVM. They need
# none of android-bootstrap's bionic linker and libs, only a JVM that works.
set -e
# jadx's zip is only on the way into /usr/local/jadx: gone however this ends, a failure too.
trap 'rm -f /tmp/jadx.zip /tmp/jadx.zip.part' EXIT
LIB=/usr/local/lib
mkdir -p "$LIB"

if ! java -version >/dev/null 2>&1; then
  echo "==> installing Alpine's JDK (musl-native HotSpot; real apk pulls the full dep tree)"
  apk add openjdk17-jre-headless
fi

fetch() {  # url, destination, sha256 (pinned: what the release publishes for this version)
  [ -f "$2" ] && { echo "  have $(basename "$2")"; return 0; }
  echo "  fetching $(basename "$2")"
  wget -q -O "$2.part" "$1" || { echo "  ! download failed"; rm -f "$2.part"; return 1; }
  [ "$(sha256sum "$2.part" | cut -d' ' -f1)" = "$3" ] || { echo "  ! checksum mismatch, not installed"; rm -f "$2.part"; return 1; }
  mv "$2.part" "$2"
}

echo "==> apktool"
fetch "https://github.com/iBotPeaches/Apktool/releases/download/v3.0.3/apktool_3.0.3.jar" \
      "$LIB/apktool.jar" dbf930b076c6b9be08d57c449cacefc3bdd6b71ebd59b3066fc0e1f5b14f9423 || true

echo "==> jadx"
if [ ! -x /usr/local/jadx/bin/jadx ]; then
  command -v unzip >/dev/null 2>&1 || apk add unzip >/dev/null || { echo "! could not install unzip (apk add unzip)"; exit 1; }
  if fetch "https://github.com/skylot/jadx/releases/download/v1.5.6/jadx-1.5.6.zip" /tmp/jadx.zip \
        545ea2be9c242511bc145755cf4bda2485ade42966e096f8b4d3da2a230e8974; then
    mkdir -p /usr/local/jadx && unzip -qo /tmp/jadx.zip -d /usr/local/jadx
    chmod +x /usr/local/jadx/bin/* 2>/dev/null || true
  fi
else
  echo "  have jadx"
fi

# The apktool and jadx commands are wrappers that come with App Development (Cinder Lite writes
# them into /usr/local/bin while the module is on), so the usual names work wherever these live.

echo
echo "==> JVM check"
java -version 2>&1 | head -3 || echo "  ! the JVM failed to start (see above)"
echo
echo "installed:"
for t in java apktool jadx baksmali smali; do
  printf '  %-10s %s\n' "$t" "$(command -v $t || echo MISSING)"
done
echo
echo "baksmali <apk> [out] and smali <dir> [out.apk] are apktool, which embeds both."
