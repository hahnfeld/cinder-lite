#!/bin/sh
# `apk add` is the muscle memory for Alpine, and the agent will reach for it before it reaches
# for sudo. /usr/local/bin comes first on PATH, so this shim shadows /sbin/apk and routes the
# write-y subcommands through the fake-root helper.
case "$1" in
  add|del|fix|upgrade) exec /usr/local/bin/sudo /sbin/apk --no-cache "$@" ;;
  *) exec /sbin/apk "$@" ;;
esac
